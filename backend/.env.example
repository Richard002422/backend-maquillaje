# Copiar a backend/api/.env y backend/ai-service/.env según corresponda.
# En Docker, los valores se inyectan vía docker-compose.

# --- API Node (Express) ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://glowlab:glowlab@localhost:5432/glowlab?schema=public

# Mínimo 32 caracteres (openssl rand -hex 32)
JWT_ACCESS_SECRET=cambiar_por_secreto_largo_de_al_menos_32_caracteres_xx

ACCESS_TOKEN_TTL_SEC=900

# Token para endpoints de administración de productos (rutas admin*)
ADMIN_API_TOKEN=cambiar_por_token_admin_panel_super_secreto

AI_SERVICE_URL=http://127.0.0.1:8000
INTERNAL_AI_TOKEN=compartido_api_ai_min_16_chars
AI_HTTP_TIMEOUT_MS=2500
AI_HTTP_RETRIES=1
AI_HTTP_RETRY_BASE_MS=200
API_JSON_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=180
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_HEAVY_MAX=20

# Orígenes CORS separados por coma (vacío = refleja cualquier origen en dev)
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# --- Amazon S3 (imágenes de productos) ---
AWS_REGION=us-east-2
AWS_S3_BUCKET=cambiar_por_nombre_de_bucket
# URL pública base (opcional; por defecto https://{bucket}.s3.{region}.amazonaws.com)
# AWS_S3_PUBLIC_BASE_URL=https://cambiar_por_nombre_de_bucket.s3.us-east-2.amazonaws.com

# --- Servicio IA (FastAPI) ---
INTERNAL_AI_TOKEN=compartido_api_ai_min_16_chars

# Coloración de cabello con IA (Gemini). Obtener en https://aistudio.google.com/apikey
GEMINI_API_KEY=definir_api_key_de_google_ai_studio
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
