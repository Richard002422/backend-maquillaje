generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecommendationStatus {
  PENDING
  COMPLETED
  FAILED
}

enum TryOnStatus {
  PROCESSING
  COMPLETED
  FAILED
}

/// Estado de cuenta gestionable desde el panel admin (Lumina). No confundir
/// con `Product.isActive`: acá ARCHIVED no existe porque una cuenta de
/// cliente no tiene un ciclo "borrador" — solo se activa/desactiva/archiva
/// como soft-delete si el usuario pide baja.
enum UserStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

/// Espejo de OrderStatus en src/types/domain.ts (panel admin Lumina).
enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model User {
  id                String               @id @default(cuid())
  email             String               @unique
  passwordHash      String
  firstName         String?              @db.VarChar(80)
  lastName          String?              @db.VarChar(80)
  phone             String?              @db.VarChar(32)
  passwordChangedAt DateTime?
  /// null = correo no verificado todavía. Se completa desde POST
  /// /auth/verify-email al consumir un EmailVerificationToken válido.
  /// No bloquea login (ver auth.ts) — hoy es informativo, no un gate.
  emailVerifiedAt   DateTime?
  skinTone          String?
  skinType          String?
  preferredStyles   String[]             @default([])
  /// Gestionable desde el panel admin (Lumina) vía PATCH
  /// /admin/customers/:id/status — no lo toca la app de cliente.
  status            UserStatus           @default(ACTIVE)
  /// Última emisión de tokens (login/registro/refresh) — ver issueTokens()
  /// en auth.ts. "Última actividad" para el panel admin; no distingue un
  /// login real de un refresh silencioso de la app, no hace falta esa
  /// granularidad hoy.
  lastLoginAt       DateTime?
  /// Consentimiento de marketing (notificaciones de producto nuevo,
  /// campañas), DISTINTO de CustomerProfile.acceptsTerms (términos del
  /// servicio) — son dos bases legales separadas, no se pueden fusionar.
  /// Default true: usuarios existentes antes de este campo no quedan
  /// excluidos retroactivamente; el opt-out es explícito vía
  /// PATCH /users/me/marketing-opt-in.
  marketingOptIn    Boolean              @default(true) @map("marketing_opt_in")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  customerProfile   CustomerProfile?
  refreshTokens     RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  recommendations   Recommendation[]
  tryOnSessions     MakeupTryOnSession[]
  orders            Order[]
  deviceTokens      DeviceToken[]
  interactionEvents InteractionEvent[]
}

/// Token de push (FCM) de un dispositivo del cliente — panel admin Lumina
/// lo usa para el fan-out de POST /v1/admin/notifications/dispatch (Fase 8).
/// Vive en Node (no en Django) por el mismo criterio que RefreshToken: está
/// atado 1:1 a User y a la sesión del dispositivo, con el mismo dueño.
model DeviceToken {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   DevicePlatform
  /// Token de FCM: único por dispositivo/instalación, no por usuario (el
  /// mismo usuario puede tener varios dispositivos, y reinstalar la app
  /// genera un token nuevo con el viejo huérfano — ver "active" abajo).
  token      String         @unique
  /// false = el registro de push falló para este token (p. ej. FCM
  /// respondió "unregistered") — se conserva para no reintentar en el
  /// próximo dispatch en vez de borrar el historial.
  active     Boolean        @default(true)
  lastSeenAt DateTime       @default(now()) @map("last_seen_at")
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([userId])
  @@map("device_tokens")
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

/// Señal ligera de comportamiento para "categorías/productos de interés"
/// del panel admin — MakeupTryOnSession y Recommendation ya cubren
/// prueba-virtual y recomendaciones, pero no navegación/búsqueda simple.
/// `refId` es polimórfico a propósito (Product.id para PRODUCT_VIEW,
/// ProductCategory.id para CATEGORY_VIEW): son dos tablas distintas, no se
/// puede modelar como una sola FK real, mismo motivo por el que
/// AuditLog usa GenericForeignKey del lado Django.
model InteractionEvent {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       InteractionType
  refId      String?
  /// Solo para type = SEARCH — el término no es el id de nada.
  searchTerm String?          @db.VarChar(160) @map("search_term")
  createdAt  DateTime         @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([type, refId])
  @@map("interaction_events")
}

enum InteractionType {
  PRODUCT_VIEW
  CATEGORY_VIEW
  SEARCH
}

/// Token de un solo uso para POST /auth/reset-password. Mismo patrón que
/// RefreshToken: solo se persiste el hash (sha256), el plano viaja únicamente
/// en el email — si la tabla se filtra, no alcanza para resetear passwords.
/// Vida corta (ver PASSWORD_RESET_TOKEN_TTL_MIN en config.ts) porque a
/// diferencia del refresh token, este habilita tomar control total de la
/// cuenta sin conocer la contraseña actual.
model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Token de un solo uso para POST /auth/verify-email. Vida más larga que el
/// de reset (ver EMAIL_VERIFICATION_TOKEN_TTL_HOURS) porque no otorga control
/// de la cuenta, solo confirma la casilla — no hay el mismo apuro por
/// expirarlo rápido.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

/// Datos de envío y consentimiento de la pantalla «Editar perfil» (1:1 con User).
model CustomerProfile {
  userId         String    @id
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Preocupaciones de piel del cliente (acné, manchas, arrugas...) — panel
  /// admin Lumina las muestra en Customer.skinProfile.concerns.
  concerns       String[]  @default([])
  undertone      String?   @db.VarChar(20)
  addressLine    String?   @db.VarChar(255)
  city           String?   @db.VarChar(120)
  postalCode     String?   @db.VarChar(20)
  country        String    @default("España") @db.VarChar(80)
  acceptsTerms   Boolean   @default(false)
  acceptsTermsAt DateTime?
  termsVersion   String?   @default("2026-06-14") @db.VarChar(40)
  /// Marca cuándo el cliente completó todos los campos obligatorios del perfil.
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("customer_profiles")
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Clase de producto (nivel superior de navegación: "Ojos", "Labios",
/// "Rostro"...). Alimenta el menú deslizable (hamburguesa) del frontend.
/// Administrable desde el panel admin — ver adminClasses.ts.
model ProductClass {
  id           String   @id @default(cuid())
  name         String   @db.VarChar(80)
  slug         String   @unique @db.VarChar(100)
  /// Emoji/ícono corto para el menú deslizable (opcional, ej. "👁️").
  icon         String?  @db.VarChar(8)
  displayOrder Int      @default(0) @map("display_order")
  /// false = oculta del menú público, pero se conserva (soft-hide, igual
  /// criterio que Product.isActive). El borrado real (DELETE) solo se
  /// permite si no tiene categorías asociadas — ver adminClasses.ts.
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  categories ProductCategory[]

  @@index([displayOrder])
  @@map("product_classes")
}

/// Categoría dentro de una clase (ej. "Sombra de ojos", "Primer" dentro de
/// "Ojos"). Alimenta la tira horizontal deslizable del frontend. El slug es
/// único solo dentro de su clase (dos clases distintas pueden reusar
/// "primer", por ejemplo "Ojos" y "Rostro").
model ProductCategory {
  id           String       @id @default(cuid())
  classId      String       @map("class_id")
  class        ProductClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  name         String       @db.VarChar(80)
  slug         String       @db.VarChar(100)
  displayOrder Int          @default(0) @map("display_order")
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  products Product[]

  @@unique([classId, slug])
  @@index([classId, displayOrder])
  @@map("product_categories")
}

/// Catálogo de productos (datos estructurados para la tienda).
model Product {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(255)
  price       Decimal  @db.Decimal(12, 2)
  /// Código ISO de la divisa de `price` (p. ej. 'EUR', 'MXN'). No convierte
  /// nada — cada producto se muestra y se factura en su propia divisa.
  currency    String   @default("EUR") @db.VarChar(8)
  /// Precio de referencia "antes de descuento", en la misma divisa que `price`.
  originalPrice   Decimal? @db.Decimal(12, 2) @map("original_price")
  discountPercent Int?     @map("discount_percent")
  description String?  @db.Text
  /// LEGADO: string libre ("Ojos", "Rostro"...). Se conserva de solo lectura
  /// por compatibilidad con mobile/ai-service mientras se completa el
  /// backfill hacia `catalogCategoryId` — no usar para productos nuevos,
  /// usar `catalogCategoryId`. Ver docs/05-contratos-api-rest.md.
  category    String   @db.VarChar(120)
  /// FK a la jerarquía Clase→Categoría (reemplaza a `category`). Nullable
  /// mientras existan productos legados sin migrar — el listado público
  /// cae a mapear `category` (string) por clase en ese caso, ver
  /// LEGACY_CATEGORY_BY_CLASS_SLUG en routes/products.ts.
  catalogCategoryId String?          @map("catalog_category_id")
  catalogCategory   ProductCategory? @relation(fields: [catalogCategoryId], references: [id], onDelete: SetNull)
  stock       Int      @default(0)
  /// Imagen principal/legado (compatibilidad con `POST /admin/products/:id/images`,
  /// que sube un único archivo a S3). El catálogo/galería real es `imageUrls`.
  imageUrl    String?  @db.Text @map("image_url")
  /// Galería completa del producto, en orden — lo que alimenta el carrusel
  /// deslizable de la ficha de producto. Si está vacío, la API cae a `[imageUrl]`.
  imageUrls   String[] @default([]) @map("image_urls")
  /// Videos del producto (demo/tutorial), mismo criterio que imageUrls.
  videoUrls   String[] @default([]) @map("video_urls")
  tags        String[] @default([])
  stockHint   String?  @db.VarChar(160) @map("stock_hint")
  aiPitch     String?  @db.Text @map("ai_pitch")
  /// URL-friendly, para la ficha pública (GET /v1/products/by-slug/:slug) en
  /// vez de exponer el uuid interno. Nullable: productos creados antes de
  /// este campo (o directo por seed) pueden no tenerlo todavía.
  slug            String?  @unique @db.VarChar(220)
  /// SEO — generados/curados por el panel admin (Lumina), el frontend público
  /// arma <title>/<meta>/OG a partir de esto (y de name/description si están
  /// vacíos). No hay tabla de Schema.org aparte: ese JSON-LD se compone en el
  /// frontend con estos campos + price/imageUrl, no hace falta persistirlo.
  metaTitle       String?  @db.VarChar(70) @map("meta_title")
  metaDescription String?  @db.VarChar(160) @map("meta_description")
  /// Soft-delete/visibilidad: false = oculto del catálogo público, pero sigue
  /// existiendo (y editable) en el panel admin. El borrado real usa DELETE.
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  recommendationItems RecommendationItem[]
  tryOnSessions       MakeupTryOnSession[]
  lashOverlay         LashOverlayAsset?
  orderItems          OrderItem[]

  @@index([category])
  @@index([catalogCategoryId])
  @@map("products")
}

/// Metadatos del probador virtual de pestañas con IA (Fase 0-4): separado de
/// `Product` porque no todo producto tiene overlay AR, y estas coordenadas se
/// validan/consumen tal cual (no un JSON opaco). El motor de render del
/// frontend (`lashTransform.ts`) resuelve una transformación de similitud
/// (traslación+rotación+escala) mapeando `anchorInner`/`anchorOuter` del PNG
/// a los landmarks del ojo detectado.
model LashOverlayAsset {
  productId  String   @id @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// PNG-32 con alpha real, listo para superponer. Ruta relativa (dev, servida
  /// desde frontend/public/) o absoluta (S3/CDN en producción) — el cliente
  /// la usa tal cual como `src`, el navegador resuelve el resto.
  overlayUrl    String  @db.Text
  canvasWidth   Int
  canvasHeight  Int
  /// Anclas normalizadas [0,1] respecto al lienzo (canvasWidth x canvasHeight).
  anchorInnerX  Float
  anchorInnerY  Float
  anchorOuterX  Float
  anchorOuterY  Float
  /// Informativo/QA — ver comentario equivalente en frontend/lashAssets.ts.
  eyeWidthRefPx Float
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("lash_overlay_assets")
}

model Recommendation {
  id            String               @id @default(cuid())
  userId        String?
  user          User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  requestedLook String?
  cartProductIds String[]            @default([])
  status        RecommendationStatus @default(COMPLETED)
  source        String               @default("ai")
  createdAt     DateTime             @default(now())
  items         RecommendationItem[]

  @@index([userId, createdAt(sort: Desc)])
}

model RecommendationItem {
  id                String         @id @default(cuid())
  recommendationId  String
  productId         String         @db.Uuid
  rank              Int
  score             Float?
  reason            String?
  createdAt         DateTime       @default(now())
  recommendation    Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  product           Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([recommendationId, rank])
  @@index([productId])
}

model MakeupTryOnSession {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId      String?      @db.Uuid
  product        Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  lookId         String
  sourceImageUrl String?
  previewUrl     String?
  maskUrls       Json?
  latencyMs      Int?
  note           String?
  status         TryOnStatus  @default(COMPLETED)
  createdAt      DateTime     @default(now())
  assets         TryOnAsset[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([productId])
}

model TryOnAsset {
  id          String            @id @default(cuid())
  sessionId   String
  kind        String
  url         String
  metadata    Json?
  createdAt   DateTime          @default(now())
  session     MakeupTryOnSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

/// Pedidos (panel admin Lumina): quién los crea hoy es un dominio aparte
/// (checkout de la app, todavía no construido — no hay carrito/pago en el
/// contrato público de este backend). Este modelo es el sistema de
/// registro para cuando exista esa Fase; hasta entonces el panel admin
/// solo lista/gestiona lo que haya (vacío es un estado válido).
model Order {
  id                 String      @id @default(uuid()) @db.Uuid
  /// Código legible para el cliente/soporte (ej. "ORD-000123"),
  /// independiente del `id` interno.
  orderNumber        String      @unique @map("order_number")
  userId             String
  user               User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  status             OrderStatus @default(PENDING)
  subtotal           Decimal     @db.Decimal(12, 2)
  discount           Decimal     @default(0) @db.Decimal(12, 2)
  shipping           Decimal     @default(0) @db.Decimal(12, 2)
  tax                Decimal     @default(0) @db.Decimal(12, 2)
  total              Decimal     @db.Decimal(12, 2)
  currency           String      @default("EUR") @db.VarChar(8)
  shippingLine1      String?     @db.VarChar(255) @map("shipping_line1")
  shippingLine2      String?     @db.VarChar(255) @map("shipping_line2")
  shippingCity       String?     @db.VarChar(120) @map("shipping_city")
  shippingState      String?     @db.VarChar(120) @map("shipping_state")
  shippingPostalCode String?     @db.VarChar(20) @map("shipping_postal_code")
  shippingCountry    String?     @db.VarChar(80) @map("shipping_country")
  notes              String?     @db.Text
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")
  items              OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("orders")
}

/// Snapshot al momento de la compra (nombre/precio/imagen no se recalculan
/// si el producto cambia o se borra después) — `product` puede quedar null
/// (SetNull) sin invalidar el historial del pedido.
model OrderItem {
  id          String   @id @default(cuid())
  orderId     String   @db.Uuid
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?  @db.Uuid
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String   @db.VarChar(255) @map("product_name")
  imageUrl    String?  @db.Text @map("image_url")
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2) @map("unit_price")
  total       Decimal  @db.Decimal(12, 2)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}
