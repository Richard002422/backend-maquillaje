generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecommendationStatus {
  PENDING
  COMPLETED
  FAILED
}

enum TryOnStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id                String               @id @default(cuid())
  email             String               @unique
  passwordHash      String
  firstName         String?              @db.VarChar(80)
  lastName          String?              @db.VarChar(80)
  phone             String?              @db.VarChar(32)
  passwordChangedAt DateTime?
  skinTone          String?
  skinType          String?
  preferredStyles   String[]             @default([])
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  customerProfile   CustomerProfile?
  refreshTokens     RefreshToken[]
  recommendations   Recommendation[]
  tryOnSessions     MakeupTryOnSession[]
}

/// Datos de envío y consentimiento de la pantalla «Editar perfil» (1:1 con User).
model CustomerProfile {
  userId         String    @id
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  addressLine    String?   @db.VarChar(255)
  city           String?   @db.VarChar(120)
  postalCode     String?   @db.VarChar(20)
  country        String    @default("España") @db.VarChar(80)
  acceptsTerms   Boolean   @default(false)
  acceptsTermsAt DateTime?
  termsVersion   String?   @default("2026-06-14") @db.VarChar(40)
  /// Marca cuándo el cliente completó todos los campos obligatorios del perfil.
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("customer_profiles")
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Catálogo de productos (datos estructurados para la tienda).
model Product {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(255)
  price       Decimal  @db.Decimal(12, 2)
  description String?  @db.Text
  category    String   @db.VarChar(120)
  stock       Int      @default(0)
  imageUrl    String?  @db.Text @map("image_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  recommendationItems RecommendationItem[]
  tryOnSessions       MakeupTryOnSession[]

  @@index([category])
  @@map("products")
}

model Recommendation {
  id            String               @id @default(cuid())
  userId        String?
  user          User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  requestedLook String?
  cartProductIds String[]            @default([])
  status        RecommendationStatus @default(COMPLETED)
  source        String               @default("ai")
  createdAt     DateTime             @default(now())
  items         RecommendationItem[]

  @@index([userId, createdAt(sort: Desc)])
}

model RecommendationItem {
  id                String         @id @default(cuid())
  recommendationId  String
  productId         String         @db.Uuid
  rank              Int
  score             Float?
  reason            String?
  createdAt         DateTime       @default(now())
  recommendation    Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  product           Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([recommendationId, rank])
  @@index([productId])
}

model MakeupTryOnSession {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId      String?      @db.Uuid
  product        Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  lookId         String
  sourceImageUrl String?
  previewUrl     String?
  maskUrls       Json?
  latencyMs      Int?
  note           String?
  status         TryOnStatus  @default(COMPLETED)
  createdAt      DateTime     @default(now())
  assets         TryOnAsset[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([productId])
}

model TryOnAsset {
  id          String            @id @default(cuid())
  sessionId   String
  kind        String
  url         String
  metadata    Json?
  createdAt   DateTime          @default(now())
  session     MakeupTryOnSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}
