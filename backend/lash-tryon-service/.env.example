# Clave interna de Django (CSRF, firma de sesiones del admin). DISTINTA de
# JWT_ACCESS_SECRET — no la compartas con nada del lado de Express.
DJANGO_SECRET_KEY=cambiar_por_una_clave_larga_y_aleatoria

# Solo se usa en config.settings.prod.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Dev local sin Docker: la instancia de Postgres del docker-compose local
# publica 5432 al host — ver backend/postgres-init/ para cómo se crea esta
# base. Dentro de docker-compose, este valor se sobreescribe en
# docker-compose.yml apuntando a postgres:5432 (igual que hace el servicio api).
DATABASE_URL=postgresql://glowlab:glowlab@localhost:5432/glowlab_lashtryon

# DEBE ser IDÉNTICO al JWT_ACCESS_SECRET de backend/api/.env — este servicio
# no emite tokens, solo verifica los que emite Express. Ver apps/core/authentication.py.
JWT_ACCESS_SECRET=

# Mismo formato que CORS_ORIGIN en backend/.env.example (lista separada por comas).
# Vacío = refleja cualquier origen (ver base.py) — solo aceptable en dev.
CORS_ORIGIN=http://127.0.0.1:5173

# Broker/backend de Celery y cache. En docker-compose local: redis:6379.
REDIS_URL=redis://localhost:6379/0
